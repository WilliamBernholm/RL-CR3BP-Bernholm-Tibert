__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Run output. Regenerated by `make train` / `make evaluate`.
# Committed artifacts are whitelisted below.
results/**/run.log
results/**/logs/
results/**/*.tmp

# Policy zips ship as a Zenodo / GitHub Release asset, not in the repo.
results/**/policies/*.zip

.DS_Store
Thumbs.db

# Downloaded run output. 321 MB; lives in a Zenodo release, not the repo.
packed/
# ANY archive. Naming them one by one left seeded.tar.gz (439 MB) and
# results_v2.tar.gz (413 MB) unignored -- 852 MB one `git add -A` away.
*.tar.gz
*.zip.part

# Run DATA is a Zenodo release asset, not repository content. Only the tiny
# provenance/manifest files are tracked.
results/**/*.npz
results/**/*.zip
results/**/*.png
results/**/eval_metrics.csv

# Preview-quality contact sheet; regenerated by `make plots --contact-sheet`.
figures/_contact_sheet.html

# Rendered figures are OUTPUT: `make plots` regenerates every one from data in
# results/. At 600 dpi they are ~24 MB and would churn the whole set on every style
# tweak. The producers are versioned; the pixels are not.
figures/
